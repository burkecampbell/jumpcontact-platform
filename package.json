{
  "name": "jumpcontact-platform",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "vitest run && next build",
    "start": "next start -p 3003",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "backfill": "dotenv -e .env.local -- tsx scripts/backfill-snapshots.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@clerk/nextjs": "^7.0.8",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "node-forge": "^1.3.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
