# JumpContact Platform — Environment Variables
# Copy to .env.local and fill in real values
# Or run: vercel env pull .env.local

# ── Required ─────────────────────────────────────────────────────────

# Google Sheets API (read-only access to Conversions, Missed Calls, Ytica sheets)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Twilio (CDR + TaskRouter for call data, speed stats, recordings)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk auth (auto-provisioned by Vercel Marketplace)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (auto-provisioned by Vercel Marketplace — neon-pink-cloud)
POSTGRES_URL=postgresql://user:pass@host/db?sslmode=require

# Cron job auth (required — all cron endpoints fail without this)
CRON_SECRET=generate-a-random-64-char-hex-string

# ── Optional ─────────────────────────────────────────────────────────

# Telegram alerts (health check sends alerts to this chat)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=0000000000

# Recording proxy auth (if set, requires ?key= on /api/calls/recording)
RECORDING_API_KEY=

# Google Sheet IDs (defaults are hardcoded in constants.ts)
CONVERSIONS_SHEET_ID=YOUR_SHEET_ID
MISSED_CALLS_SHEET_ID=YOUR_SHEET_ID
YTICA_SHEET_ID=YOUR_SHEET_ID

# Agent config overrides (comma-separated, lowercase)
ACTIVE_AGENTS=omar,burke,ian,danny,chris,wendy,sara,george,sue
OUTBOUND_AGENTS=william,joseph
EXCLUDED_AGENTS=sara,sue

# Ops Center (MSC/GHL conversion source)
OPS_CENTER_URL=https://operations-center-phi.vercel.app

# HubSpot Private App (JC Portal YOUR_PORTAL_ID — outbound sales dashboard)
HUBSPOT_PAT=pat-na3-xxxxx
